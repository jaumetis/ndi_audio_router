<Window x:Class="NdiAudioRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:NdiAudioRouter"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{Binding [AppTitle], Source={x:Static local:Loc.I}}"
        Background="{StaticResource BgApp}"
        Height="1000" Width="1300" MinWidth="1220" MinHeight="780"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="190"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Capçalera: títol, emissor NDI, idioma i estat ===== -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,36,0">
                        <TextBlock Text="{Binding [AppTitle], Source={x:Static local:Loc.I}}"
                                   FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding [AppSubtitle], Source={x:Static local:Loc.I}}"
                                   FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBox x:Name="NdiName" Text="Audio PC" Width="260" Height="36" VerticalContentAlignment="Center"
                                 ui:ControlHelper.Header="{Binding [StreamName], Source={x:Static local:Loc.I}}"/>
                        <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}" Width="130" Height="36"
                                Margin="12,0,0,0" Click="BtnStart_Click"/>
                        <CheckBox x:Name="ChkV2" IsChecked="True" Margin="20,0,0,2" VerticalAlignment="Bottom"
                                  Content="{Binding [NdiV2], Source={x:Static local:Loc.I}}"
                                  Checked="Fmt_Changed" Unchecked="Fmt_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border CornerRadius="10" Background="{StaticResource BgInner}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" Padding="3" HorizontalAlignment="Right"
                                ToolTip="{Binding [LanguageTip], Source={x:Static local:Loc.I}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangCa" Content="CA" GroupName="lang" Style="{StaticResource SegButton}"
                                             ToolTip="Català" Checked="Lang_Checked"/>
                                <RadioButton x:Name="LangEn" Content="EN" GroupName="lang" Style="{StaticResource SegButton}"
                                             ToolTip="English" Checked="Lang_Checked"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,2,0" HorizontalAlignment="Right">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#6B7280" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" FontSize="13.5" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== ASIO ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [AsioTitle], Source={x:Static local:Loc.I}}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="AsioDriverBox" Width="300" ItemsSource="{Binding AsioDrivers}"
                                  ui:ControlHelper.Header="{Binding [AsioDriver], Source={x:Static local:Loc.I}}"/>
                        <ComboBox x:Name="AsioMonitorBox" Width="270" Margin="12,0,0,0"
                                  ui:ControlHelper.Header="{Binding [AsioMonitorOut], Source={x:Static local:Loc.I}}"/>
                        <Button x:Name="BtnAsio" Style="{StaticResource GhostButton}" Width="140" Margin="12,0,0,0"
                                VerticalAlignment="Bottom" Click="BtnAsio_Click"/>
                        <TextBlock x:Name="AsioStatus" Foreground="{StaticResource TextDim}" FontSize="13.5"
                                   VerticalAlignment="Bottom" Margin="18,0,0,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Rutes ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding [RoutesTitle], Source={x:Static local:Loc.I}}" Style="{StaticResource CardTitle}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Margin="20,0,0,0" Click="AddRoute_Click"
                                Content="{Binding [AddRoute], Source={x:Static local:Loc.I}}"/>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Refresh_Click"
                                Content="{Binding [RefreshDevices], Source={x:Static local:Loc.I}}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Capçalera: mateixes columnes que les files -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="2*" MinWidth="200"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="2*" MinWidth="180"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Margin="8,0,0,0"
                                       Text="{Binding [ColActive], Source={x:Static local:Loc.I}}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Margin="6,0,0,0"
                                       Text="{Binding [ColInput], Source={x:Static local:Loc.I}}"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource CardTitle}" Margin="6,0,0,0"
                                       Text="{Binding [ColSrcCh], Source={x:Static local:Loc.I}}"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource CardTitle}" Margin="6,0,0,0"
                                       Text="{Binding [ColNdiCh], Source={x:Static local:Loc.I}}"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource CardTitle}" Margin="6,0,0,0"
                                       Text="{Binding [ColGain], Source={x:Static local:Loc.I}}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="RoutesGrid" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Routes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" MinHeight="46">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="2*" MinWidth="200"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="2*" MinWidth="180"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="0"
                                                          IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,4"
                                                          ItemsSource="{Binding DataContext.InputDevices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="Name"/>
                                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,4"
                                                          ItemsSource="{Binding SourceChannels}"
                                                          SelectedItem="{Binding SourceChannel, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,4"
                                                          ItemsSource="{Binding DataContext.OutputChannels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding OutputChannel, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Grid Grid.Column="4" Margin="10,0,6,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="-60" Maximum="12" VerticalAlignment="Center"
                                                            Value="{Binding GainDb, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding GainDb, StringFormat={}{0:F1}}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource NumFont}" Foreground="{StaticResource TextDim}"/>
                                                </Grid>
                                                <Button Grid.Column="5" Content="✕" Style="{StaticResource GhostButton}" Width="36" MinHeight="32"
                                                        Padding="0" HorizontalAlignment="Center" Click="RemoveRoute_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Canals de sortida NDI + configuració ID/OSC ===== -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding [ChannelsTitle], Source={x:Static local:Loc.I}}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding [ChannelsHint], Source={x:Static local:Loc.I}}" Margin="14,0,0,0"
                                       FontSize="12" Foreground="{StaticResource TextFaint}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ChannelList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3" Padding="8,14,8,12" CornerRadius="12" Background="{StaticResource BgInner}"
                                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Width="88">
                                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontSize="22"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="14"
                                                     TextAlignment="Center" FontSize="13" Margin="0,8,0,0"/>
                                            <local:MeterBar Width="64" Height="190" Margin="0,14,0,6" HorizontalAlignment="Center"
                                                            Level="{Binding Level}" Peak="{Binding Peak}" Dimmed="{Binding Mute}"/>
                                            <TextBlock Text="{Binding PeakText}" HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource NumFont}" FontSize="13.5"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <ToggleButton Style="{StaticResource SoloButton}" Margin="0,12,0,0"
                                                          IsChecked="{Binding Solo, Mode=TwoWay}"
                                                          Content="{Binding [Solo], Source={x:Static local:Loc.I}}"/>
                                            <ToggleButton Style="{StaticResource MuteButton}" Margin="0,6,0,0"
                                                          IsChecked="{Binding Mute, Mode=TwoWay}"
                                                          Content="{Binding [Mute], Source={x:Static local:Loc.I}}"/>
                                            <ToggleButton Style="{StaticResource GenButton}" Margin="0,6,0,0"
                                                          IsChecked="{Binding Gen, Mode=TwoWay}"
                                                          Content="{Binding [IdOsc], Source={x:Static local:Loc.I}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Configuració ID / OSC -->
                    <Border Grid.Column="1" Margin="14,0,0,0" Padding="16" CornerRadius="12" Width="250" VerticalAlignment="Top"
                            Background="{StaticResource BgInner}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [GenTitle], Source={x:Static local:Loc.I}}" Style="{StaticResource CardTitle}"/>
                            <RadioButton x:Name="RbId" GroupName="gen" IsChecked="True" Margin="0,12,0,0" Checked="GenConfig_Changed"
                                         Content="{Binding [GenId], Source={x:Static local:Loc.I}}"/>
                            <RadioButton x:Name="RbOsc" GroupName="gen" Checked="GenConfig_Changed"
                                         Content="{Binding [GenOsc], Source={x:Static local:Loc.I}}"/>
                            <ComboBox x:Name="CmbFreq" ItemsSource="{Binding ToneFreqs}" Margin="0,10,0,0"
                                      HorizontalAlignment="Stretch" SelectionChanged="GenConfig_Changed"
                                      ui:ControlHelper.Header="{Binding [GenFreq], Source={x:Static local:Loc.I}}"/>
                            <TextBlock x:Name="LevelText" Margin="0,14,0,2" Foreground="{StaticResource TextDim}" FontSize="13"/>
                            <Slider x:Name="SldLevel" Minimum="-40" Maximum="0" Value="-18" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="GenConfig_Changed"/>
                            <TextBlock x:Name="VoiceText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextFaint}"
                                       TextWrapping="Wrap"/>
                            <ToggleButton x:Name="BtnMuteAll" Style="{StaticResource MuteButton}" Margin="0,18,0,0" Click="MuteAll_Click"
                                          Content="{Binding [MuteAll], Source={x:Static local:Loc.I}}"/>
                            <ToggleButton x:Name="BtnGenAll" Style="{StaticResource GenButton}" Margin="0,8,0,0" Click="GenAll_Click"
                                          Content="{Binding [GenAll], Source={x:Static local:Loc.I}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Monitor i diagnòstic ===== -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding [MonitorTitle], Source={x:Static local:Loc.I}}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="MonDevice" Width="340" DisplayMemberPath="Name"
                                  ItemsSource="{Binding OutputDevices}" SelectionChanged="MonDevice_Changed"
                                  ui:ControlHelper.Header="{Binding [MonDevice], Source={x:Static local:Loc.I}}"/>
                        <StackPanel Margin="28,0,0,0">
                            <TextBlock Text="{Binding [MonVolume], Source={x:Static local:Loc.I}}" Foreground="{StaticResource TextDim}"
                                       FontSize="13" Margin="0,0,0,8"/>
                            <Slider x:Name="MonVol" Minimum="0" Maximum="1.5" Value="1" Width="240" ValueChanged="Monitor_VolChanged"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="DiagText" Margin="0,16,0,0" FontSize="12" LineHeight="18"
                               FontFamily="{StaticResource NumFont}" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
