<Window x:Class="NdiAudioRouter.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{StaticResource BgApp}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        MinWidth="440" MaxWidth="560" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Msg" TextWrapping="Wrap" FontSize="14.5" LineHeight="22"
                   Foreground="{StaticResource TextPrimary}" MaxWidth="480"/>
        <StackPanel x:Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,24,0,0"/>
    </Grid>
</Window>
